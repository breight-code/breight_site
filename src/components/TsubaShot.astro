---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang } from "../content/site";
import { tsuba, type Shot } from "../content/tsuba";

interface Props { lang: Lang; shot: Shot; sizes: string; eager?: boolean }
const { lang, shot, sizes, eager = false } = Astro.props;
// Same file names per language: the Italian page shows the Italian UI.
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/tsuba/*/*.png", { eager: true });
const src = files[`../assets/tsuba/${lang}/${shot}.png`].default;
const widths = [480, 800, 1200].filter((w) => w < src.width).concat(src.width);
---
<Picture
  src={src}
  alt={tsuba[lang].shots[shot]}
  formats={["avif", "webp"]}
  fallbackFormat="webp"
  widths={widths}
  sizes={sizes}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  decoding="async"
/>
