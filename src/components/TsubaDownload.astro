---
// Download button with click feedback (see the script in TsubaPage.astro). The href stays real: it works without JS.
import type { Lang } from "../content/site";
import { tsuba, tsubaLinks } from "../content/tsuba";

interface Props { lang: Lang; label: string; large?: boolean }
const { lang, label, large } = Astro.props;
const t = tsuba[lang].download;
const note = `${t.noteCheck} ${t.noteNot} <a href="${tsubaLinks.releases}" target="_blank" rel="noreferrer">${t.noteGithub}</a> · <a href="#download-steps">${t.noteSteps}</a>`;
---
<div class="ts-dl">
  <a class:list={["ts-btn", { "ts-btn-lg": large }]} href={tsubaLinks.download} data-dl data-state="idle">
    <span class="ts-ico" aria-hidden="true">
      <svg class="i-idle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11m-5-5 5 5 5-5M5 20h14"/></svg>
      <span class="i-busy"></span>
      <svg class="i-done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
    </span>
    <span class="ts-lbls">
      <span class="l-idle">{label}</span>
      <span class="l-busy">{t.busy}</span>
      <span class="l-done">{t.done}</span>
    </span>
  </a>
  <div class="ts-dl-note" role="status" aria-live="polite" data-note={note}><div><p></p></div></div>
</div>
