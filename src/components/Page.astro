---
import HeroTitle from "./HeroTitle";
import ScrollWords from "./ScrollWords";
import StackLanes from "./StackLanes";
import Terminal from "./Terminal";
import Work from "./Work";
import CodeType from "./CodeType";
import HeroBackdrop from "./HeroBackdrop";
import { arrowSvg as arrow, copy, developerCode, links, markSvg as mark, type Lang } from "../content/site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const other = lang === "it" ? "/en/" : "/";
const year = new Date().getFullYear();
const mail = `mailto:${links.email}?subject=${encodeURIComponent(t.contact.mailSubject)}`;
---
<a class="skip" href="#main">{lang === "it" ? "Vai al contenuto" : "Skip to content"}</a>
<header class="bar" data-ink="night">
  <a class="wordmark" href={lang === "it" ? "/" : "/en/"} aria-label="br(e)ight-code.it, home"><Fragment set:html={mark} />br(e)ight-code.it</a>
  <nav aria-label={lang === "it" ? "Principale" : "Main"}>
    <a class="hide-sm" href="#skills">{t.nav.skills}</a>
    <a class="hide-sm" href="#work">{t.nav.work}</a>
    <a class="hide-sm" href="#contact">{t.nav.contact}</a>
    <a href={other} hreflang={lang === "it" ? "en" : "it"} lang={lang === "it" ? "en" : "it"}>{t.nav.other}</a>
    <a class="pill" href={mail}><b>{t.nav.hire}</b></a>
  </nav>
</header>

<main id="main">
  <section class="chapter hero" data-ink="night" id="top">
    <HeroBackdrop client:load />
    <HeroTitle client:load lines={t.hero.lines} label={t.hero.h1} />
    <div class="hero-foot">
      <div>
        <p class="lead" data-reveal style="--i:1">{t.hero.sentence}</p>
        <div class="hero-actions" data-reveal style="--i:2">
          <a class="btn" href={mail}>{t.hero.primary}<Fragment set:html={arrow} /></a>
          <a class="link" href="#work">{t.hero.secondary}</a>
        </div>
      </div>
      <CodeType client:load code={developerCode} />
    </div>
  </section>

  <section class="chapter intro" data-ink="paper" aria-labelledby="intro-title">
    <h2 id="intro-title" class="sr-only">{lang === "it" ? "Chi sono" : "About"}</h2>
    <ScrollWords client:visible text={t.intro.lead} />
  </section>

  <section class="chapter stack" data-ink="signal" id="skills" aria-labelledby="stack-title">
    <div class="stack-top">
      <h2 id="stack-title" class="head" data-reveal>{t.skills.title}</h2>
      <p data-reveal style="--i:1">{t.skills.text}</p>
    </div>
    <StackLanes client:visible lanes={t.skills.lanes} />
  </section>

  <section class="chapter" data-ink="night" id="terminal" aria-labelledby="term-title">
    <div class="term-wrap">
      <div class="side">
        <h2 id="term-title" class="head" data-reveal>{t.terminal.title}</h2>
        <p data-reveal style="--i:1">{t.terminal.text}</p>
      </div>
      <Terminal client:visible lang={lang} />
    </div>
  </section>


  <section class="chapter" data-ink="paper" id="work" aria-labelledby="work-title">
    <div class="work-top">
      <h2 id="work-title" class="head" data-reveal>{t.work.title}</h2>
      <p data-reveal style="--i:1">{t.work.text}</p>
    </div>
    <Work client:visible items={t.work.items} labels={{ live: t.work.live, code: t.work.code, privateCode: t.work.privateCode, page: t.work.page }} />
  </section>

  <section class="chapter contact" data-ink="night" id="contact" aria-labelledby="contact-title">
    <div class="contact-top">
      <h2 id="contact-title" class="head" data-reveal>{t.contact.title}</h2>
      <p data-reveal style="--i:1">{t.contact.text}</p>
    </div>
    <ul class="rows">
      {t.contact.rows.map((r, i) => (
        <li data-reveal style={`--i:${i}`}>
          {r.href ? (
            <a class="row" href={r.href} target={r.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
              <span class="lbl">{r.label}</span>
              <span class="val display">{r.value}</span>
              <span class="arrow"><Fragment set:html={arrow} /></span>
            </a>
          ) : (
            <div class="row">
              <span class="lbl">{r.label}</span>
              <span class="val display">{r.value}</span>
            </div>
          )}
        </li>
      ))}
    </ul>
  </section>
</main>

<footer class="chapter foot" data-ink="signal">
  <div class="foot-top">
    <a class="wordmark" href="#top"><Fragment set:html={mark} />br(e)ight-code.it</a>
    <p>{t.footer.note}</p>
    <a class="link" href="#top">{t.footer.top}</a>
  </div>
  <div></div>
  <a class="foot-mail display" href={mail} data-reveal-mail>
    <span class="part"><span style="--i:0">br8st99</span></span>
    <span class="part"><span style="--i:1">@gmail.com</span></span>
  </a>
  <div class="foot-meta">
    <div><a class="link" href={links.github} target="_blank" rel="noreferrer">GitHub</a><a class="link" href={links.pub} target="_blank" rel="noreferrer">Pub.dev</a></div>
    <span>© {year} Marco Brotto</span>
    <span>{t.footer.place}</span>
  </div>
</footer>

