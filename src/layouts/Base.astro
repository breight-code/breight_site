---
import "../styles/global.css";
import { copy, links, type Lang } from "../content/site";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  noindex?: boolean;
  // Site-relative paths of the same page in each language, for hreflang.
  alternates?: { it: string; en: string };
  // Site-relative image path for og:image and twitter:image.
  image?: string;
  imageAlt?: string;
  // Replaces the projects list in the structured data; Person and WebSite always stay.
  jsonLd?: object[];
  // Browser chrome colour; sub-sites with their own palette pass their background.
  themeColor?: string;
}
const {
  lang,
  noindex = false,
  alternates = { it: "/", en: "/en/" },
  image = "/og.png",
  imageAlt = "br(e)ight-code, software development",
  jsonLd,
  themeColor = "#0b0d0b",
} = Astro.props;
const t = copy[lang];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const alt = { it: new URL(alternates.it, site).href, en: new URL(alternates.en, site).href };
const og = new URL(image, site).href;

const person = {
  "@type": "Person",
  "@id": `${links.site}/#person`,
  name: "Marco Brotto",
  alternateName: "br(e)ight-code",
  jobTitle: "Software developer",
  email: `mailto:${links.email}`,
  url: links.site,
  image: `${links.site}/icon-512.png`,
  address: { "@type": "PostalAddress", addressLocality: "Montebelluna", addressRegion: "TV", addressCountry: "IT" },
  knowsAbout: ["Flutter", "Dart", "BLoC", "Node.js", "TypeScript", "Express", "GraphQL", "Sequelize", "PostgreSQL", "Mobile development", "Backend development"],
  sameAs: [links.github, links.pub],
};
const website = {
  "@type": "WebSite",
  "@id": `${links.site}/#website`,
  url: links.site,
  name: "br(e)ight-code.it",
  inLanguage: lang === "it" ? "it-IT" : "en-US",
  publisher: { "@id": `${links.site}/#person` },
};
const projectList = {
  "@type": "ItemList",
  name: t.work.title,
  itemListElement: t.work.items.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: { "@type": "SoftwareSourceCode", name: p.title, description: p.description, programmingLanguage: p.stack, ...(p.live ? { url: p.live } : {}), ...(p.code ? { codeRepository: p.code } : {}) },
  })),
};
const structured = {
  "@context": "https://schema.org",
  "@graph": jsonLd ? [person, website, ...jsonLd] : [person, website, projectList],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Marco Brotto" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    {!noindex && <>
      <link rel="alternate" hreflang="it" href={alt.it} />
      <link rel="alternate" hreflang="en" href={alt.en} />
      <link rel="alternate" hreflang="x-default" href={alt.it} />
    </>}
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="br(e)ight-code.it" />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "it" ? "en_US" : "it_IT"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>
  <body>
    <slot />
    <script>
      // Entrances once per element; header takes the ink of the chapter under it.
      const reveal = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); reveal.unobserve(e.target); } }),
        { threshold: 0.01 },
      );
      const seen = new WeakSet<Element>();
      const watch = () =>
        document.querySelectorAll("[data-reveal]:not(.in), [data-reveal-mail]:not(.in)").forEach((el) => {
          // Re-observing an element resets its pending entry, so observe each one once.
          if (seen.has(el)) return;
          seen.add(el);
          reveal.observe(el);
        });
      watch();
      // React islands hydrate later and may add new targets.
      new MutationObserver(watch).observe(document.body, { childList: true, subtree: true });

      // The 404 page has no header, so the ink observer is skipped there.
      const bar = document.querySelector<HTMLElement>(".bar");
      if (bar) {
        const ink = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) bar.dataset.ink = (e.target as HTMLElement).dataset.ink; }),
          { rootMargin: "-32px 0px -95% 0px" },
        );
        document.querySelectorAll("main > [data-ink], body > footer[data-ink]").forEach((el) => ink.observe(el));
      }
    </script>
  </body>
</html>
