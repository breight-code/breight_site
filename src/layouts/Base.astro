---
import "../styles/global.css";
import { copy, links, type Lang } from "../content/site";

interface Props { lang: Lang; title?: string; description?: string; noindex?: boolean }
const { lang, noindex = false } = Astro.props;
const t = copy[lang];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const alt = { it: new URL("/", site).href, en: new URL("/en/", site).href };
const og = new URL("/og.png", site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${links.site}/#person`,
      name: "Marco Brotto",
      alternateName: "br(e)ight-code",
      jobTitle: "Software developer",
      email: `mailto:${links.email}`,
      url: links.site,
      image: `${links.site}/icon-512.png`,
      address: { "@type": "PostalAddress", addressLocality: "Montebelluna", addressRegion: "TV", addressCountry: "IT" },
      knowsAbout: ["Flutter", "Dart", "BLoC", "Node.js", "TypeScript", "Express", "GraphQL", "Sequelize", "PostgreSQL", "Mobile development", "Backend development"],
      sameAs: [links.github, links.pub],
    },
    {
      "@type": "WebSite",
      "@id": `${links.site}/#website`,
      url: links.site,
      name: "br(e)ight-code.it",
      inLanguage: lang === "it" ? "it-IT" : "en-US",
      publisher: { "@id": `${links.site}/#person` },
    },
    {
      "@type": "ItemList",
      name: t.work.title,
      itemListElement: t.work.items.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: { "@type": "SoftwareSourceCode", name: p.title, description: p.description, programmingLanguage: p.stack, ...(p.live ? { url: p.live } : {}), ...(p.code ? { codeRepository: p.code } : {}) },
      })),
    },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Marco Brotto" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    {!noindex && <>
      <link rel="alternate" hreflang="it" href={alt.it} />
      <link rel="alternate" hreflang="en" href={alt.en} />
      <link rel="alternate" hreflang="x-default" href={alt.it} />
    </>}
    <meta name="theme-color" content="#0b0d0b" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="br(e)ight-code.it" />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "it" ? "en_US" : "it_IT"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="br(e)ight-code, software development" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
